{
   "action": {
      "default_icon": {
         "48": "icon.png"
      },
      "default_popup": "popup/popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "js": [
            "marked.min.js",
            "content.js"
         ],
         "matches": [
            "\u003Call_urls>"
         ]
      }
   ],
   "description": "Barbara 是一款 Chrome 擴充工具，依賴LLM API雙語翻譯、文章摘要和聊天功能。",
   "host_permissions": [
      "\u003Call_urls>",
      "file:///*"
   ],
   "icons": {
      "48": "icon.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Barbara: Local AI Assistant",
   "options_ui": {
      "open_in_tab": false,
      "page": "settings.html"
   },
   "permissions": [
      "storage",
      "activeTab",
      "contextMenus",
      "sidePanel",
      "clipboardRead"
   ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.49",
   "web_accessible_resources": [
      {
         "matches": [
            "\u003Call_urls>"
         ],
         "resources": [
            "icon.png",
            "lang.gif",
            "summary.gif"
         ]
      }
   ]
}